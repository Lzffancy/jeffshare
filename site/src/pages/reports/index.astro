---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";

const reportsDir = path.resolve("../content/reports");
const reportDirs: { name: string; files: string[] }[] = [];

if (fs.existsSync(reportsDir)) {
  for (const entry of fs.readdirSync(reportsDir, { withFileTypes: true })) {
    if (entry.isDirectory()) {
      const dirPath = path.join(reportsDir, entry.name);
      const files = fs.readdirSync(dirPath).filter((f) => !f.startsWith("."));
      reportDirs.push({ name: entry.name, files });
    }
  }
}
reportDirs.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Reports — Jeff 的工作台">
  <div class="max-w-3xl mx-auto px-5 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-primary">Reports</h1>
      <p class="text-base-content/60 mt-1">研究报告文件柜 · 共 {reportDirs.length} 份报告</p>
    </div>

    {
      reportDirs.length === 0 ? (
        <p class="text-base-content/40 italic">还没有报告，敬请期待。</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {reportDirs.map((r) => (
            <a
              href={`/reports-files/${r.name}/`}
              class="card bg-base-100 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-200 no-underline"
            >
              <div class="card-body p-5">
                <h2 class="card-title text-primary text-lg flex items-center gap-2">
                  <span class="text-2xl">📊</span>
                  {r.name}
                </h2>
                <p class="text-sm text-base-content/60 mt-1">
                  {r.files.length} 个文件
                </p>
                <div class="flex flex-wrap gap-1 mt-2">
                  {r.files.map((f) => (
                    <span class="badge badge-xs bg-[#e8f4fd] text-[#0277bd] border-0">{f}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
