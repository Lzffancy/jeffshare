---
// Share index page — list all share files
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";

const shareDir = path.resolve("../content/share");
const files: { name: string; path: string; size: string }[] = [];

if (fs.existsSync(shareDir)) {
  for (const entry of fs.readdirSync(shareDir, { withFileTypes: true })) {
    if (entry.isFile() && entry.name.endsWith(".html") && entry.name !== "index.html") {
      const filePath = path.join(shareDir, entry.name);
      const stat = fs.statSync(filePath);
      const sizeKb = (stat.size / 1024).toFixed(1);
      const cleanName = entry.name.replace(/\.html$/, "");
      files.push({ name: cleanName, path: `/share/${cleanName}`, size: `${sizeKb} KB` });
    }
  }
}
files.sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Share — Jeff 的工作台">
  <div class="max-w-3xl mx-auto px-5 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-primary">Share</h1>
      <p class="text-base-content/60 mt-1">分享工作台 · 论文笔记与静态页面 · 共 {files.length} 个文件</p>
    </div>

    {
      files.length === 0 ? (
        <p class="text-base-content/40 italic">还没有分享内容，敬请期待。</p>
      ) : (
        <ul class="divide-y divide-base-300 bg-base-100 rounded-box shadow-sm px-5">
          {files.map((f) => (
            <li class="py-3 flex items-center justify-between">
              <a
                href={f.path}
                class="text-primary font-semibold hover:text-accent transition-colors no-underline"
              >
                📄 {f.name}
              </a>
              <span class="text-sm text-base-content/40">{f.size}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
